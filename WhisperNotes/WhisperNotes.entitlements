<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TestFlight 서명에 쓰는 엔타이틀먼트 (scripts/testflight.sh의 둘째 인자, PLAN.md §4).
  CI 빌드는 서명 없이 하므로 여기 적은 것은 TestFlight 빌드에만 들어간다. 프로필에 없는 키가 있으면 testflight.sh가 멈춘다:
  App ID에서 그 기능을 켜고 App Store 프로필을 다시 만든다.
-->
<plist version="1.0">
<dict>
	<!-- 완료 후 전사의 BGContinuedProcessingTask에서만 백그라운드 GPU를 쓴다 (준실시간 전사에는 해당 없음) -->
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
	<!-- Background Inference (iPadOS 27+). 27부터는 백그라운드에서 뉴럴 엔진을 쓰려면 BGContinuedProcessingTask 안이든 밖이든 이것이 있어야 한다.
	     녹음 중 백그라운드에서 준실시간 전사(뉴럴 엔진)를 이어 가고, 완료 후 전사를 뉴럴 엔진으로 백그라운드에서 이어 갈 때 쓴다. 26.x는 이 키를 무시한다 -->
	<key>com.apple.developer.background-tasks.continued-processing.inference</key>
	<true/>
	<!-- 메모리 한도를 높인다. 완료 후 전사를 하다 메모리가 모자라 앱이 꺼지는 일이 잦아서 켰다 (2026-11-05) -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
