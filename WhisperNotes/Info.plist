<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>위스퍼 필기</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- App Store Connect가 64비트 바이너리에 요구한다 (업로드 오류 90502). 이 Info.plist는 직접 쓴 것이라 넣는다 -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 표준 암호화(HTTPS 등)만 쓴다. TestFlight 빌드마다 수출 규정 질문을 받지 않게 (PLAN.md §4) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>강의를 녹음해 전사합니다. 녹음과 전사는 이 기기 안에서만 처리합니다.</string>
	<!-- 화면을 끄거나 다른 앱으로 가도 녹음을 이어 간다 (PLAN.md §4) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 완료 후 전사의 BGContinuedProcessingTask (PLAN.md §3.3). 식별자는 <번들 ID>.final.<세션>.<시각> -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).final.*</string>
	</array>
	<!-- Files 앱에서 녹음·전사본을 꺼낸다 (CER 시험용 녹음 반출, PLAN.md §6) -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- 아이패드 앱은 네 방향을 모두 지원해야 멀티태스킹 조건에 맞는다 (업로드 검사) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>WhisperNotesBuild</key>
	<dict>
		<key>Run</key>
		<string>$(WHISPERNOTES_BUILD_RUN)</string>
		<key>Branch</key>
		<string>$(WHISPERNOTES_BUILD_BRANCH)</string>
		<key>Commit</key>
		<string>$(WHISPERNOTES_BUILD_COMMIT)</string>
	</dict>
</dict>
</plist>
